name: IP Check
description: 提供精准的IP信息展示、全中文显示、IP纯净度显示、延迟抖动测试及下行测速功能，使用说明：设置IP信息URL为http://ipwho.de/json（IPv4/IPv6双栈）或https://4.ipwho.de/json（仅IPv4），并在模板参数指定策略组，请在你指定的策略组下进行测试
compat_arguments:
  指定策略组: DIRECT  
compat_arguments_desc: 指定ipwho.de、speed.cloudflare.com、ippure.com及延迟测试走的策略组，默认为DIRECT，请在你指定的策略组下进行测试

env_schema:
  SHOW_LATENCY_TEST:
    name: 延迟测试功能
    description: 开启后测试并显示节点的延迟情况，默认开启
    default_value: 开启
    options:
      - 开启
      - 关闭
  LATENCY_COUNT:
    name: 延迟测试次数
    description: 设置延迟测试的发包次数，默认为1次
    default_value: 1次
    options:
      - 1次
      - 2次
      - 3次
      - 4次
      - 5次
  LATENCY_TARGET:
    name: 延迟测试目标
    description: 设置测延迟的目标地址，默认 Google 204
    default_value: Google 204
    options:
      - Google 204
      - Cloudflare
  SHOW_SPEED_TEST:
    name: 下行测速功能
    description: 下行测速的功能开关，开启后可以显示节点的下行带宽，默认关闭，关闭后可以节省流量并加快响应
    default_value: 关闭
    options:
      - 开启
      - 关闭
  SPEED_TEST_PACKET:
    name: 下行测速数据量
    description: 设置单次下行测速的数据量，默认为3MB，网速慢/响应久的可以适当调低该参数
    default_value: 3MB
    options:
      - 1MB
      - 1.5MB
      - 2MB
      - 2.5MB
      - 3MB
      - 3.5MB
      - 4MB
  SPEED_TEST_TIMEOUT:
    name: 测速超时
    description: 设置下行测速的超时时间，默认为5秒，网速慢的可以适当调高该参数
    default_value: 5秒
    options:
      - 2.5秒
      - 3秒
      - 3.5秒
      - 4秒
      - 4.5秒
      - 5秒
      - 5.5秒
      - 6秒
      - 6.5秒
  SHOW_IPPURE:
    name: IP纯净度显示
    description: 开启后可以显示节点的原生属性与风险评级信息，数据来自IPPure，默认关闭
    default_value: 关闭
    options:
      - 开启
      - 关闭  
author: unknownTokyo
rules:
- domain:
    match: speed.cloudflare.com
    policy: "{{{指定策略组}}}"
- domain_suffix:
    match: ippure.com
    policy: "{{{指定策略组}}}" 
- domain_suffix:
    match: ipwho.de
    policy: "{{{指定策略组}}}"
scriptings:
- http_response:
    name: IP Check
    match: ^https?://(?:4\.)?ipwho\.de(?::\d+)?(?:[/?#]|$)
    script_url: https://raw.githubusercontent.com/ZID412/ipzujian/main/ipxx-jb
    update_interval: 86400
    timeout: 8
    body_required: true
    binary_body: false
    env:
      POLICY: "{{{指定策略组}}}" 
mitm:
  hostnames:
    includes:
    - 4.ipwho.de
    - ipwho.de
